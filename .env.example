# Copy this file to .env before running docker compose

# Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=csv_import

# API settings
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/csv_import
REDIS_URL=redis://redis:6379/0
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=50

# Email settings (Mailpit needs no login and no TLS)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
DEFAULT_NOTIFY_EMAIL=admin@example.com
APP_BASE_URL=http://localhost:8000

# Retry settings (a task is tried MAX_ATTEMPTS times, with exponential backoff and jitter between tries)
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=60

# Job timeout and crash recovery (a task that runs longer than JOB_TIMEOUT_SECONDS gets a soft time limit
# error and is retried. A task whose worker died is delivered again after VISIBILITY_TIMEOUT_SECONDS, which
# must be more than JOB_TIMEOUT_SECONDS + 30. WORKER_CONCURRENCY is the number of tasks one worker container runs at once)
JOB_TIMEOUT_SECONDS=600
VISIBILITY_TIMEOUT_SECONDS=900
WORKER_CONCURRENCY=1

# Logging (every log line is one JSON object). DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
