# Copy this file to .env before running docker compose

# Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=csv_import

# API settings
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/csv_import
REDIS_URL=redis://redis:6379/0
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=50

# Email settings (Mailpit needs no login and no TLS)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
DEFAULT_NOTIFY_EMAIL=admin@example.com
APP_BASE_URL=http://localhost:8000

# Retry settings (a job is tried MAX_ATTEMPTS times, with exponential backoff between tries)
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=60

# Crash recovery settings (a worker refreshes its heartbeat every HEARTBEAT_INTERVAL_SECONDS, and is
# considered dead when the heartbeat has not been refreshed for HEARTBEAT_TTL_SECONDS. Every worker
# looks for dead workers every REAPER_INTERVAL_SECONDS. A job that runs longer than JOB_TIMEOUT_SECONDS fails)
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TTL_SECONDS=15
REAPER_INTERVAL_SECONDS=5
JOB_TIMEOUT_SECONDS=600
